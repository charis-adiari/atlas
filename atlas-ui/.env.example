# Copy to .env.local and change what you need. Every variable is optional: the defaults below suit local development.

# Where the Atlas API runs. The app server forwards /api/v1 requests there.
API_PROXY_TARGET=http://localhost:8080

# Where the browser sends API requests. Leave it as is so they go through the app server, which holds the session cookie.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Origins the browser may send sign-up, login and other state-changing requests from, comma separated. Set it only
# behind a reverse proxy that changes the host. When it is not set, the request's own origin is used.
# APP_ORIGINS=https://atlas.example.com

# Whether cookies are marked Secure, so browsers only send them over HTTPS. Defaults to true in a production build and
# false otherwise. Set it to false to run a production build over plain HTTP, such as on your own machine.
# COOKIE_SECURE=false
